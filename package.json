{
  "name": "agentic-search",
  "version": "0.8.2",
  "description": "Search for documents, sheets, slides, tables, tasks, forms, boards, files and comments, for people and agents. Ports and adapters, access filtered, Cloudflare first.",
  "keywords": [
    "search",
    "full-text",
    "bm25",
    "fts5",
    "mcp",
    "Model Context Protocol",
    "agents",
    "cloudflare",
    "d1",
    "gdpr"
  ],
  "license": "MIT",
  "author": "Pooria Arab",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pooriaarab/agentic-search.git"
  },
  "type": "module",
  "private": false,
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist",
    "migrations"
  ],
  "publishConfig": {
    "access": "public"
  },
  "mcpName": "io.github.pooriaarab/agentic-search",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js"
    },
    "./testing": {
      "types": "./dist/testing/index-contract.d.ts",
      "import": "./dist/testing/index-contract.js"
    },
    "./d1": {
      "types": "./dist/adapters/d1.d.ts",
      "import": "./dist/adapters/d1.js"
    },
    "./worker": {
      "types": "./dist/worker.d.ts",
      "import": "./dist/worker.js"
    },
    "./ui": {
      "types": "./dist/ui/index.d.ts",
      "import": "./dist/ui/index.js"
    },
    "./ui.css": "./dist/ui.css",
    "./account": {
      "types": "./dist/account.d.ts",
      "import": "./dist/account.js"
    }
  },
  "bin": {
    "agentic-search": "./dist/cli.js",
    "agentic-search-mcp": "./dist/mcp-bin.js"
  },
  "scripts": {
    "build": "tsup && npm run build:demo",
    "typecheck": "tsc --noEmit && tsc -p demo",
    "test": "vitest run",
    "clean": "rm -rf dist demo-dist",
    "ci:local": "npm run build && npm run typecheck && npm test && npm run test:e2e",
    "deploy:demo": "WRANGLER_SEND_METRICS=false npx wrangler deploy --config wrangler.demo.jsonc",
    "build:demo": "vite build --config demo/vite.config.ts",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.23.0",
    "agentic-design": ">=0.8.0 <1.0.0",
    "agentic-identity": ">=0.9.0 <1.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "esbuild": "^0.28.2",
    "miniflare": "^4.20260730.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsup": "^8.0.0",
    "typescript": "^5.6.0",
    "vite": "^7.3.7",
    "vitest": "^3.0.0",
    "wrangler": "^4.156.0"
  },
  "peerDependencies": {
    "vitest": ">=3",
    "react": ">=18",
    "react-dom": ">=18"
  },
  "peerDependenciesMeta": {
    "vitest": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  }
}
